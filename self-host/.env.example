# =============================================================================
# SoundDocs self-host environment.
#
# Copy this to `.env` (or run ./setup.sh to generate one with strong secrets):
#   cp .env.example .env
#
# Variable names match the OFFICIAL Supabase self-host compose so they stay
# familiar and upgradable. NEVER commit your real .env (it's gitignored).
# =============================================================================

############################################################
# SECRETS  -- generate strong unique values. ./setup.sh does this for you.
############################################################

# Postgres superuser password (also used by the Supabase service roles).
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# Signing secret for all JWTs. MUST be >= 32 chars. The ANON_KEY and
# SERVICE_ROLE_KEY below MUST be JWTs signed with THIS secret (HS256).
# Generate: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Public API key embedded in the web app (role: anon). It is a JWT signed by
# JWT_SECRET. The bundled example below is the SUPABASE DEMO key and is INSECURE
# -- ./setup.sh derives a real one, or use https://supabase.com/docs/guides/self-hosting#api-keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Privileged API key (role: service_role). JWT signed by JWT_SECRET. Keep
# secret. The bundled example below is the SUPABASE DEMO key and is INSECURE.
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Realtime/Supavisor cookie/session signing base. Generate: openssl rand -hex 32
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1u2oq

# Studio dashboard HTTP basic-auth (the credentials Kong prompts for at the
# Supabase Studio URL). CHANGE THESE.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

############################################################
# WEB APP
#
# These values are injected at RUNTIME by docker-entrypoint.sh when using the
# prebuilt GHCR image (ghcr.io/sounddocs/sounddocs-web). No rebuild is needed
# when you change them — just `docker compose up -d web` to restart the
# container with the new values.
#
# They are also passed as build args to apps/web/Dockerfile so that
# `docker compose build web` (local source builds) still works. In that case
# the values are baked into the JS bundle AND injected at runtime; the runtime
# values take priority (see apps/web/src/lib/runtimeConfig.ts).
############################################################

# Point the web app at the Kong gateway public URL. For a local install this
# equals SUPABASE_PUBLIC_URL below (http://localhost:KONG_HTTP_PORT).
# If you serve SoundDocs from another machine/domain, set this to the URL the
# BROWSER will use to reach Kong (e.g. https://supabase.example.com).
VITE_SUPABASE_URL=http://localhost:8000

# MUST equal ANON_KEY above.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE

# Host port the SoundDocs web app is served on (http://localhost:WEB_PORT).
WEB_PORT=3000

# NOTE: VITE_SELF_HOSTED=true is set automatically in docker-compose.yml's
# `web` service environment block — you do NOT need to set it here. It enables
# the in-app first-run setup wizard (import your hosted-app backup).

############################################################
# PUBLIC URLS
############################################################

# The externally reachable URL of the Supabase API gateway (Kong). For local
# use this is http://localhost:KONG_HTTP_PORT.
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000

# Where the auth service sends users back to (the web app origin).
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

############################################################
# DATABASE
############################################################
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############################################################
# KONG (API gateway) PORTS
############################################################
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############################################################
# AUTH
############################################################
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true

# IMPORTANT for offline / single-user instances WITHOUT an SMTP server:
# set this to true so newly created accounts are auto-confirmed and can log in
# immediately (otherwise GoTrue waits for an email confirmation it can't send).
ENABLE_EMAIL_AUTOCONFIRM=true

ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# SMTP (only needed if you turn ENABLE_EMAIL_AUTOCONFIRM off and want real
# confirmation/recovery emails). The defaults are placeholders.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############################################################
# EDGE FUNCTIONS
############################################################
# The app calls led-map-to-png / svg-to-png with an anon Authorization header,
# and ai-align-systems via supabase.functions.invoke (sends the anon JWT).
# Leaving JWT verification OFF at the runtime keeps all three working with the
# anon key out of the box. (Kong still fronts them at /functions/v1/*.)
FUNCTIONS_VERIFY_JWT=false

############################################################
# POSTGREST
############################################################
PGRST_DB_SCHEMAS=public,storage,graphql_public

############################################################
# STORAGE (local file backend; S3 values are stubs)
############################################################
STORAGE_TENANT_ID=stub
REGION=stub
GLOBAL_S3_BUCKET=stub

############################################################
# STUDIO
############################################################
STUDIO_DEFAULT_ORGANIZATION=SoundDocs
STUDIO_DEFAULT_PROJECT=SoundDocs

############################################################
# IMGPROXY
############################################################
IMGPROXY_AUTO_WEBP=true
